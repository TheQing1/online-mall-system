{
  "uid": "online-mall",
  "title": "Online Mall · API 概览",
  "tags": ["online-mall"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "请求量（按状态码）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "P99 延迟（按接口）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, path))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "缓存操作（命中/未命中/写入）与 Redis 可用性",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(cache_operations_total[1m]))",
          "legendFormat": "{{result}}"
        },
        {
          "refId": "B",
          "expr": "redis_up",
          "legendFormat": "redis_up"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "被限流拦截 / 定时任务执行",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (scope) (rate(rate_limit_blocked_total[5m]))",
          "legendFormat": "限流 {{scope}}"
        },
        {
          "refId": "B",
          "expr": "sum by (result) (increase(background_task_runs_total[5m]))",
          "legendFormat": "定时任务 {{result}}"
        }
      ]
    }
  ]
}
