# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
# 本地跑测试时用 --basetemp 指定的临时目录（Windows 上系统临时目录可能不可写）
.pytest-tmp/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ---- 环境与密钥 ----
# .env 含真实密钥，绝不入库；.env.example 只放占位符，需要提交
.env
.env.*
!.env.example

# ---- 虚拟环境 ----
.venv/
venv/

# ---- 前端 ----
node_modules/
frontend/dist/
admin/dist/

# ---- 大文件 / 自动生成 ----
# 向量库与 Embedding 模型缓存（约 183MB）都在 backend/data 下。
# 注意：早期这里误写成 backend/models、backend/chroma_db，而当时实际路径是
# backend/app/models/models 与 backend/app/chroma_db，导致模型权重没被忽略。
backend/data/
# 兼容历史路径
backend/app/models/models/
backend/app/chroma_db/
backend/models/
backend/chroma_db/

# ---- 日志与编辑器 ----
*.log
.idea/
.vscode/
.DS_Store

# ---- 内部规划草稿 ----
.superpowers/
