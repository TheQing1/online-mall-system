# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ---- 环境与密钥 ----
# .env 含真实密钥，绝不入库；.env.example 只放占位符，需要提交
.env
.env.*
!.env.example

# ---- 虚拟环境 ----
.venv/
venv/

# ---- 前端 ----
node_modules/
frontend/dist/
admin/dist/

# ---- 大文件 / 自动生成 ----
# 注意：模型缓存与向量库都在 app/ 包内部（app/models/models、app/chroma_db），
# 早期这里误写成 backend/models、backend/chroma_db，导致 183MB 模型权重没被忽略。
backend/app/models/models/
backend/app/chroma_db/
# 兼容旧路径
backend/models/
backend/chroma_db/

# ---- 日志与编辑器 ----
*.log
.idea/
.vscode/
.DS_Store

# ---- 内部规划草稿 ----
.superpowers/
