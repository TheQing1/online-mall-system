# docker compose 自动读取这个文件（仓库根目录，文件名必须叫 .env）。
#
# 别和 backend/.env.example 搞混，两者用途不同：
#   根目录 .env      → 给 docker compose 用：容器之间怎么连、部署密钥、对外端口
#   backend/.env     → 给「不用 Docker、直接在宿主机跑 uvicorn」用
# 容器里连的是 mysql / redis 这两个服务名，不是 localhost，所以两份配置不能混用。
#
# 用法：cp .env.example .env，然后改掉标了【必须改】的项。
# 不想手动改就跑 deploy/bootstrap.sh，它会自动生成随机密钥并写进 .env。

# ---- 运行环境 ----
# development：启动自检不通过只打告警，方便 clone 下来直接跑
# production ：启动自检不通过直接拒绝启动（deploy 里的 prod override 会自动设成它）
MALL_ENV=development

# ----【必须改】数据库口令 ----
# 生成：openssl rand -hex 16
MYSQL_ROOT_PASSWORD=mall_root_123

# ----【必须改】JWT 签名密钥 ----
# 还是示例值时 production 环境会拒绝启动，这是有意为之：密钥一旦可猜，
# 任何人都能自己签一个管理员 token 登进后台。
# 生成：openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production

# ---- AI 客服 ----
# 不配也能跑：商城、下单、支付、后台全部正常，只有聊天会返回
# 「请先在 .env 中配置 DEEPSEEK_API_KEY」——这是刻意的降级，不是崩溃。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---- 数据库名 ----
MYSQL_DATABASE=online_mall

# ---- 站点对外端口 ----
# 不用 HTTPS：0.0.0.0 / 80，直接访问 http://服务器IP
# 用 docker-compose.tls.yml（Caddy 自动 HTTPS）时改成 127.0.0.1 / 8080，
# 把 80 和 443 让给 Caddy
WEB_BIND=0.0.0.0
WEB_HTTP_PORT=80

# ---- 后端调试端口（/docs、/metrics）----
# 生产建议 127.0.0.1：接口文档和指标只在本机看，公网扫不到。
# 是否真的收紧了由 deploy/check-prod-env.sh 校验，光靠这句注释不算数。
API_BIND=0.0.0.0
API_PORT=8000

# ---- HTTPS（只有叠加 docker-compose.tls.yml 时才需要）----
# DOMAIN：已经解析到本机的域名，例如 mall.example.com。Caddy 靠它申请证书，
#         所以必须先配好 DNS 再启动，否则会一直重试。
# ACME_EMAIL：证书到期提醒邮箱，可以留空。
DOMAIN=
ACME_EMAIL=

# ---- 可观测性（只有 docker compose --profile observability up -d 时才用到）----
GRAFANA_PASSWORD=admin
