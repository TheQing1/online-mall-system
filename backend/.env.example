ENVIRONMENT=development

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=online_mall

JWT_SECRET_KEY=your-secret-key-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ORDER_EXPIRE_MINUTES=30

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Redis：缓存 / 限流 / 分布式锁；不可用时自动降级为无缓存、不限流
REDIS_URL=redis://localhost:6379/0
CACHE_PRODUCT_TTL=60
CACHE_NEGATIVE_TTL=30

# 限流（固定窗口，单位秒）
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_API=300
RATE_LIMIT_LOGIN=10
RATE_LIMIT_ORDER=20
RATE_LIMIT_CHAT=20

# 日志：true 输出单行 JSON；慢请求阈值（毫秒）
LOG_JSON=false
LOG_SLOW_REQUEST_MS=500

# RAG 检索：vector（纯向量）或 hybrid（向量 + BM25 融合）
RAG_RETRIEVAL_MODE=hybrid
RAG_MIN_RELEVANCE=0.3
RAG_VECTOR_WEIGHT=0.6
RAG_BM25_WEIGHT=0.4
# 交叉编码器重排（首次开启会下载约 1.1GB 模型）
RAG_RERANK_ENABLED=false

UPLOAD_DIR=static/products
MAX_UPLOAD_SIZE=2097152
